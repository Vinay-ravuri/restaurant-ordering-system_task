# ==============================================================
# RestaurantOS - Global / Root Environment Configuration Example
# ==============================================================

# Backend Port and Environment
PORT=4000
NODE_ENV=development

# Database URL (PostgreSQL hosted on Supabase or Local PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restaurantos?schema=public"

# Direct URL for Prisma migrations if using Supabase connection pooler
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/restaurantos?schema=public"

# JWT Secret for Staff Authentication (Admin & Kitchen roles)
JWT_SECRET="restaurantos_dev_super_secret_jwt_key_at_least_32_characters_long"

# Allowed Frontend Origins (Comma-separated for CORS)
FRONTEND_ORIGIN="http://localhost:5173"

# Frontend Vite API URL (Used by Frontend)
VITE_API_URL="http://localhost:4000"
